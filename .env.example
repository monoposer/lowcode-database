# Meta database (lc_* metadata + lc_tenants)
META_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lowcode_meta

# Default tenant data database (physical lc_t_* tables)
DEFAULT_TENANT_DATA_DSN=postgresql://postgres:postgres@localhost:5432/lowcode_data
DEFAULT_TENANT_ID=default

# Storage is always record (tenant shards + LIST partitions).
# See docs/architecture/virtual-records.md and docs/architecture/record-calc.md
# VR_DEFAULT_SHARD_DSN=   # optional; defaults to DEFAULT_TENANT_DATA_DSN

# Calc (formula/lookup/rollup cache) always runs inside cmd/server.
# CALC_WORKER_BATCH=16
# CALC_WORKER_POLL_MS=500

# Event bus: memory (default) or redis (requires REDIS_URL)
# EVENT_BUS=memory
# EVENT_STREAM_KEY=lc:events

# Optional: used by cmd/migrate -target data
# DATA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lowcode_data

# Optional: create tenant databases via API
# DATA_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# DATA_DSN_TEMPLATE=postgresql://postgres:postgres@localhost:5432/%s

HTTP_ADDR=:8080
MAX_ROW=100

# Redis (optional): metadata cache
# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=300

# pg_stat_statements list API (GET /v1/admin/pg-stat-statements).
# Requires Postgres shared_preload_libraries=pg_stat_statements (docker-compose sets this)
# and data migration 000002. Off by default.
# PG_STAT_STATEMENTS=true

# Logging
# LOG_LEVEL=info
# SLOW_QUERY_THRESHOLD_MS=500
# LOG_SQL=true

# API key auth (optional; when true, /v1/* requires X-Api-Key)
# API_KEY_REQUIRED=false
# RATE_LIMIT_RPS=100

# RBAC / AUTHZ_* is not in this version (see docs/roadmap.md).

# Integration tests
# TEST_META_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lowcode_meta
# TEST_DATA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lowcode_data

# Postgres pool (meta + tenant data)
# PG_MAX_CONNS=10
# PG_MIN_CONNS=1
# PG_MAX_CONN_LIFETIME_MIN=60
# MAX_TENANT_DATA_POOLS=50
# DEFAULT_TENANT_POOL_MAX_CONNS=0
# POOL_HOT_IDLE_SECONDS=300
# POOL_CREATE_WAIT_MS=2000

# Overload protection
# RATE_LIMIT_GLOBAL_RPS=0
# RATE_LIMIT_TENANT_RPS=0
# MAX_SCAN_ROWS=0
# MAX_BULK_ITEMS=500
# MAX_EXPORT_ROWS=100000
# DDL_CONFIRM_REQUIRED=true

# Calc reliability
# CALC_MAX_RETRY=8
# CALC_TENANT_CONCURRENCY=8
# CALC_ALERT_QUEUE_LEN=10000
# INDEX_BACKFILL_TIMEOUT_SEC=300
